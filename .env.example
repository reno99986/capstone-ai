# JWT Secret Key (must match your backend service)
JWT_SECRET_KEY=CLASSIFIED

# Database connection (READ ONLY recommended)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/geotags_db

# Chatbot model (optional, default: llama3.2)
CHATBOT_MODEL=llama3.2

# Ollama API URL (optional, default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Server configuration
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
