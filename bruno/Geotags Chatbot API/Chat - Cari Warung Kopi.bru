}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "message": "Cari warung kopi di Balikpapan",
    "top_k": 5
  }
}

settings {
  encodeUrl: true
}

docs {
  Chat dengan bot untuk mencari warung kopi
}
